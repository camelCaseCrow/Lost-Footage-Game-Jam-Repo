  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 104cb8e2cf4095e4bbd377cc400ce635, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueBox: {fileID: 1266156441}
  playerInput: {fileID: 602533912}
  leftStatue: {fileID: 1987825116}
  listenWhisperSound:
    idInternal: 0
    valueGuidInternal: 
    WwiseObjectReference: {fileID: 0}
  openMyEyesSound:
    idInternal: 0
    valueGuidInternal: 
    WwiseObjectReference: {fileID: 0}
  silenceSeconds: 5
  leftStatueLines:
  - (One of two massive angel statues. It only has one eye.)
  - (Listen closer?)
  comingFromHereLines:
  - "(\u2026It's coming from here, somehow!)"
  afterSilenceLines:
  - "('Open my eyes, so that I may see'\u2026?)"
  - (You look up at its face. It looks back.)
  - I can't tell if it's me or you they're playing a sick joke on, angel.
  - You can't open your 'eyes' if you only have one!
  - (You try to laugh. It gets swallowed by the silence.)
  - "(\u2026)"
  - (It is cold, and you are alone.)
