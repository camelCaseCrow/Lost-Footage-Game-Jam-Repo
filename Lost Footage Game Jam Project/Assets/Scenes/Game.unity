  m_Name: 
  m_EditorClassIdentifier: 
  dialogueBox: {fileID: 1266156441}
  notYetLines:
  - (Can't leave yet.)
  - (You've got a stupid job to do.)
  lockedLines:
  - (You didn't notice before, but the main door has an oddly shaped hollow in its
    centre, separated into four slots. Strange.)
  - (Not that you need to care. You reach for the handle-)
  - '?'
  - (The door doesn't open.)
  - What the-
  - (The door still doesn't open.)
  - Fuck- I swear, is that you, Jo? I thought you said this lock doesn't work anymore!
    HEY!
  - (The door   doesn't   open.)
  - Shit.
  - (Is there another way out of here?)
  stillLockedLines:
  - (It still won't FUCKING open.)
  - "Is it just jammed? Jo's an idiot, but she wouldn't lock me in here\u2026"
  - She's too scared of me. I'd fuck her up.
  - (The thought makes you smile.)
  - (The door has an oddly shaped hollow in its centre, separated into four slots.)
  - (Engraved around it are the words, 'PRAISE HE WHO IS WATCHING'.)
  stillLockedAgainLines:
  - (And nope, it's still not opening.)
  openLines:
  - (The Eye is complete.)
  - (The door creaks open,)
  - (but you can't move)
  - (because)
  - (He is watching)
  - "(\u2026)"
  - (Above you.)
  tryOpenSound:
    idInternal: 0
    valueGuidInternal: 
    WwiseObjectReference: {fileID: 0}
  doorOpenSound:
    idInternal: 0
    valueGuidInternal: 
    WwiseObjectReference: {fileID: 0}
